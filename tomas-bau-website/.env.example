# Confirm the actual production domain before deploying.
# Used at build time for canonical URLs, social metadata, JSON-LD and sitemap.
NEXT_PUBLIC_SITE_URL=https://www.tomasbau.de

# Server-only: create a Resend API key and verify the sender domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Optional override; defaults to the business address in lib/site.ts.
CONTACT_TO_EMAIL=bautomas23@gmail.com
# Set true ONLY behind a proxy that replaces x-forwarded-for (e.g. Vercel).
# Otherwise requests share a conservative 5 requests / 10 minutes limit.
CONTACT_TRUST_PROXY=false
